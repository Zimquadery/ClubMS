generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  CLUB_ADMIN
  FACULTY
  STUDENT
}

enum MembershipStatus {
  PENDING
  ACTIVE
  ALUMNI
  REJECTED
}

enum MemberRole {
  MEMBER
  OFFICER
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  role          UserRole @default(STUDENT)
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   ClubMembership[]
  rsvps         EventRsvp[]
  auditLogs     AuditLog[]
  announcements Announcement[]
  eventHosts    EventHost[]
}

model Club {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?
  category      String
  logoUrl       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   ClubMembership[]
  eventHosts    EventHost[]
  announcements Announcement[]
  invites       EventHostInvite[]
}

model EventHostInvite {
  id        String   @id @default(uuid())
  eventId   String
  clubId    String
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([eventId, clubId])
  @@index([clubId])
}

model ClubMembership {
  id        String           @id @default(uuid())
  userId    String
  clubId    String
  status    MembershipStatus @default(PENDING)
  role      MemberRole       @default(MEMBER)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId, status, role])
}

model Event {
  id          String   @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  venue       String?
  venueId     String?
  bannerUrl   String?
  tags        String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  managedVenue Venue?     @relation(fields: [venueId], references: [id], onDelete: SetNull)
  hosts        EventHost[]
  invites      EventHostInvite[]
  rsvps        EventRsvp[]

  @@index([startTime])
  @@index([venueId])
}

model Venue {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]
}

model EventHost {
  id        String   @id @default(uuid())
  eventId   String
  clubId    String
  isPrimary Boolean  @default(false)
  addedById String?
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  addedBy   User?    @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([eventId, clubId])
  @@index([clubId, isPrimary])
}

model EventRsvp {
  id        String     @id @default(uuid())
  eventId   String
  userId    String
  status    RsvpStatus @default(GOING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  actorId    String?
  targetType String?
  targetId   String?
  metadata   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
}

model Announcement {
  id        String   @id @default(uuid())
  clubId    String
  authorId  String?
  title     String   @db.VarChar(200)
  content   String   @db.Text
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club   Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([clubId, pinned, createdAt])
}
